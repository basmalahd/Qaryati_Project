# Application environment: development | test | production
# In production, do NOT use a .env file: set real environment variables (Docker/host/secret
# manager). A .env file is ignored when APP_ENV=production is set in the real environment.
APP_ENV=development
POSTGRES_USER=qaryati
POSTGRES_PASSWORD=change_me
POSTGRES_DB=qaryati
DATABASE_URL=postgresql+psycopg://qaryati:change_me@db:5432/qaryati

# Must be at least 32 characters. Generate one with:
#   docker run --rm python:3.12-slim python -c "import secrets;print(secrets.token_hex(32))"
# Production additionally rejects placeholder/default-looking or low-variety secrets.
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Browser origins allowed to call the API (comma-separated, scheme://host[:port], no trailing
# slash). Empty = no cross-origin access. A wildcard (*) is rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: external geocoding provider (defaults shown). Put a contact in the User-Agent.
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODING_USER_AGENT=QaryatiCourseProject/1.0 (your-email@example.com)
# GEOCODING_TIMEOUT_SECONDS=5
# GEOCODING_MAX_RETRIES=2
